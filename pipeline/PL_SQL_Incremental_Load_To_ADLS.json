{
	"name": "PL_SQL_Incremental_Load_To_ADLS",
	"properties": {
		"activities": [
			{
				"name": "WEB_GetServerName",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-retailkart-utkarsh.vault.azure.net/secrets/sql-server-name?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "SET_v_serverName",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "WEB_GetServerName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_serverName",
					"value": {
						"value": "@activity('WEB_GetServerName').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "WEB_GetDatabaseName",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "SET_v_serverName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-retailkart-utkarsh.vault.azure.net/secrets/sql-database-name?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "SET_v_databaseName",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "WEB_GetDatabaseName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_databaseName",
					"value": {
						"value": "@activity('WEB_GetDatabaseName').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "WEB_GetUserName",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "SET_v_databaseName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-retailkart-utkarsh.vault.azure.net/secrets/sql-username?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "SET_v_userName",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "WEB_GetUserName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_userName",
					"value": {
						"value": "@activity('WEB_GetUserName').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "LK_OldWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "SET_v_userName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT last_watermark_value\nFROM dbo.pipeline_watermark\nWHERE source_table_name = '@{pipeline().parameters.sourceTableName}';",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": "dbo",
							"tableName": "pipeline_watermark",
							"ds_serverName": "@variables('v_serverName')",
							"ds_databaseName": "@variables('v_databaseName')",
							"ds_userName": "@variables('v_userName')"
						}
					}
				}
			},
			{
				"name": "LK_NewWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "LK_OldWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT MAX(@{pipeline().parameters.watermarkColumn}) AS new_watermark_value\nFROM @{pipeline().parameters.sourceSchemaName}.@{pipeline().parameters.sourceTableName};",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": "@pipeline().parameters.sourceSchemaName",
							"tableName": "@pipeline().parameters.sourceTableName",
							"ds_serverName": "@variables('v_serverName')",
							"ds_databaseName": "@variables('v_databaseName')",
							"ds_userName": "@variables('v_userName')"
						}
					}
				}
			},
			{
				"name": "CP_Incremental_SQL_to_ADLS",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "LK_NewWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT *\nFROM @{pipeline().parameters.sourceSchemaName}.@{pipeline().parameters.sourceTableName}\nWHERE @{pipeline().parameters.watermarkColumn} >\n      '@{activity('LK_OldWatermark').output.firstRow.last_watermark_value}'\n  AND @{pipeline().parameters.watermarkColumn} <=\n      '@{activity('LK_NewWatermark').output.firstRow.new_watermark_value}';",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": "@pipeline().parameters.sourceSchemaName",
							"tableName": "@pipeline().parameters.sourceTableName",
							"ds_serverName": "@variables('v_serverName')",
							"ds_databaseName": "@variables('v_databaseName')",
							"ds_userName": "@variables('v_userName')"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"containerName": "@pipeline().parameters.targetContainer",
							"folderPath": "@pipeline().parameters.targetFolderPath",
							"fileName": "@pipeline().parameters.targetFileName"
						}
					}
				]
			},
			{
				"name": "SC_UpdateWatermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "CP_Incremental_SQL_to_ADLS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Retail",
					"type": "LinkedServiceReference",
					"parameters": {
						"serverName": "@variables('v_serverName')",
						"databaseName": "@variables('v_databaseName')",
						"userName": "@variables('v_userName')",
						"passwordSecretName": "sql-password  (plain text)"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "UPDATE dbo.pipeline_watermark\nSET    last_watermark_value = '@{activity('LK_NewWatermark').output.firstRow.new_watermark_value}',\n       last_updated_at      = SYSUTCDATETIME()\nWHERE  source_table_name    = '@{pipeline().parameters.sourceTableName}';"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "DB_SCD2_Customer",
				"type": "DatabricksNotebook",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "SC_UpdateWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": []
			}
		],
		"parameters": {
			"sourceSchemaName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"sourceTableName": {
				"type": "string",
				"defaultValue": "retail_customers_source"
			},
			"watermarkColumn": {
				"type": "string",
				"defaultValue": "updated_at"
			},
			"targetContainer": {
				"type": "string",
				"defaultValue": "raw"
			},
			"targetFolderPath": {
				"type": "string",
				"defaultValue": "retail/customers/incremental/"
			},
			"targetFileName": {
				"type": "string",
				"defaultValue": "customers_incremental.parquet"
			}
		},
		"variables": {
			"v_serverName": {
				"type": "String"
			},
			"v_databaseName": {
				"type": "String"
			},
			"v_userName": {
				"type": "String"
			}
		},
		"annotations": []
	}
}